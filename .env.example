# AI 제공자 — 현재: OpenAI (개발/테스트)
# 실전 배포 시: OPENAI_API_KEY 주석 처리 후 ANTHROPIC_API_KEY 활성화
OPENAI_API_KEY=

# 실전 배포용 Anthropic (현재 비활성)
# ANTHROPIC_API_KEY=sk-ant-...

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel API — JWT 검증에 anon key 사용 (서버 env 필수)
# 클로즈드 베타: SUBSCRIPTION_REQUIRED 미설정 또는 false
# 유료 정식: SUBSCRIPTION_REQUIRED=true
SUBSCRIPTION_REQUIRED=

# Vercel Cron (/api/cron/billing, /api/cron/cleanup)
CRON_SECRET=

# 분석 API 분당 한도 (Vercel 인스턴스별, 기본 20)
ANALYZE_RATE_LIMIT_PER_MINUTE=20

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 토스페이먼츠
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 앱 설정
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_TOSS_CLIENT_KEY=
EXPO_PUBLIC_PROJECT_ID=
# true = 결제 UI 숨김(무료 베타). 정식 출시 시 false 또는 변수 제거
EXPO_PUBLIC_PROTOTYPE_FREE_MODE=true

# 개인정보처리방침 — Vercel 로그 레벨 설정
# info 레벨 비활성화 → request body(SMS 원문)가 Vercel 인프라 로그에 기록되지 않음
# Vercel Dashboard > Settings > Environment Variables에도 동일하게 등록 필수
VERCEL_LOG_LEVEL=error

# 구글이 전 세계적으로 수집한 안전하지 않은 웹 리소스(피싱 사이트, 악성 소프트웨어 배포 사이트 등)의 목록 조회 인증키
# Google Cloud Console에서 발급
GOOGLE_SAFE_BROWSING_API_KEY=